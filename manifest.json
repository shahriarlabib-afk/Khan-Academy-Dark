{
  "manifest_version": 3,
  "name": "Khan Academy Dark",
  "version": "1.0.1",
  "description": "A carefully tuned dark theme for Khan Academy. Remaps the site's real colors instead of inverting them.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.khanacademy.org/*", "https://*.kastatic.org/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.khanacademy.org/*"],
      "js": ["colors.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Khan Academy Dark",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
